        <script><![CDATA[(function executeRule(current, previous) {

    var isInternational =
        current.getValue('travel_type') == 'international';

    var visaRequired =
        current.getValue('visa_required') == 'true';

    if (!isInternational) {

        current.visa_required = false;
        current.visa_details = '';

        return;
    }

    if (visaRequired &&
        current.getValue('visa_details').trim() == '') {

        gs.addErrorMessage(
            'Visa Details are required when Visa Required is true for international travel.'
        );

        current.setAbortAction(true);
        return;
    }

    if (!visaRequired) {
        current.visa_details = '';
    }

})(current, previous);]]></script>
